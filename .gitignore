# Base de dados de imagens (locais e baixadas por scripts)
escolha/
dados/plantvillage/
dados/fotos_reais/
scripts/baixar_dados.sh
agro_saude.db
teste_agro_saude.db

# Diretório de uploads e banco SQLite
dados/uploads/*
!dados/uploads/.gitkeep
banco/*.db

# Python, Jupyter e ambientes virtuais
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
plant/
.env
.venv/
env/
venv/

# Modelos do AgroSaúde (permite os 3 modelos das culturas no repositório)
modelos/*.onnx
!modelos/batata.onnx
!modelos/tomate.onnx
!modelos/milho.onnx
!modelos/README.md
# PjBL2: metadados, métricas e figuras dos modelos
!modelos/*.classes.json
!modelos/metricas_*.json
!modelos/*.png

# Logs e arquivos temporários de sistema
*.log
.DS_Store
